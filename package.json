{
  "name": "wolfsen-party",
  "productName": "派对软件 - 狼森",
  "version": "1.2.0",
  "description": "派对主持工具：玩家档案、活动、手机任务与全场积分",
  "author": "狼森",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "build": "vite build",
    "test": "node --test tests/*.test.cjs",
    "dist:win": "pnpm build && electron-builder --win portable --x64 --publish never",
    "start": "electron ."
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "electron": "44.9.0",
    "electron-builder": "^26.0.12",
    "jsdom": "30.1.3",
    "lucide-react": "^1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "build": {
    "appId": "com.wolfsenparty.desktop",
    "productName": "派对软件 - 狼森",
    "executableName": "WolfsenParty",
    "asar": true,
    "files": [
      "desktop/**/*",
      "dist/**/*",
      "assets/icon.png",
      "package.json",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/**/*",
      "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**/*",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**/*",
      "LICENSE"
    ],
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "WolfsenParty-${version}-Windows-x64.exe",
      "requestExecutionLevel": "user",
      "useZip": true
    },
    "npmRebuild": false,
    "compression": "normal",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-node/bin/napi-v6/win32/x64/**/*"
    ],
    "extraResources": [
      {
        "from": "assets/models",
        "to": "models"
      },
      {
        "from": "assets/THIRD-PARTY-NOTICES.txt",
        "to": "THIRD-PARTY-NOTICES.txt"
      }
    ]
  },
  "dependencies": {
    "@tensorflow-models/blazeface": "0.1.0",
    "@tensorflow/tfjs": "4.22.0",
    "onnxruntime-node": "1.30.0",
    "qrcode": "1.5.4"
  },
  "license": "MIT",
  "packageManager": "pnpm@11.25.0"
}
